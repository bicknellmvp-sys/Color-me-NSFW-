<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="800" height="1000" style="background: #0d0e0f;">
  <rect width="800" height="1000" fill="#0d0e0f"/>
  <rect x="50" y="50" width="700" height="900" fill="none" stroke="#e3e2e2" stroke-width="4"/>
  <rect x="70" y="70" width="660" height="860" fill="none" stroke="#e50026" stroke-width="2"/>
  
  {/* Bound Demon / Esoteric Sigil */}
  <circle cx="400" cy="500" r="250" fill="none" stroke="#e3e2e2" stroke-width="3"/>
  <circle cx="400" cy="500" r="230" fill="none" stroke="#e50026" stroke-width="1.5" stroke-dasharray="8 4"/>
  <path d="M 150,500 L 650,500 M 400,250 L 400,750" stroke="#e3e2e2" stroke-width="2"/>
  <polygon points="400,200 600,600 200,600" fill="none" stroke="#e50026" stroke-width="3"/>
  
  <text x="400" y="925" fill="#e3e2e2" font-family="monospace" font-size="16" letter-spacing="4" text-anchor="middle">EXH. 04 — THE BOUND DEMON</text>
</svg>
