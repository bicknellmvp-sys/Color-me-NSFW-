<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="800" height="1000" style="background: #0d0e0f;">
  <rect width="800" height="1000" fill="#0d0e0f"/>
  <!-- Ornate Gothic Frame -->
  <rect x="50" y="50" width="700" height="900" fill="none" stroke="#e3e2e2" stroke-width="4"/>
  <rect x="70" y="70" width="660" height="860" fill="none" stroke="#e50026" stroke-width="2"/>
  
  {/* Throne & Sovereign Geometry */}
  <path d="M 400,150 L 550,300 L 500,750 L 300,750 L 250,300 Z" fill="none" stroke="#e3e2e2" stroke-width="3"/>
  <circle cx="400" cy="250" r="80" fill="none" stroke="#e50026" stroke-width="3"/>
  <path d="M 400,100 L 400,900 M 150,500 L 650,500" stroke="#444748" stroke-width="1.5" stroke-dasharray="8 8"/>
  
  {/* Restraint / Domination Motifs */}
  <path d="M 250,300 L 400,450 L 550,300" fill="none" stroke="#e3e2e2" stroke-width="2"/>
  <path d="M 300,750 L 200,900 M 500,750 L 600,900" stroke="#e3e2e2" stroke-width="3"/>
  <path d="M 350,500 Q 400,580 450,500 Q 400,420 350,500" fill="none" stroke="#e50026" stroke-width="3"/>
  
  <!-- Typography Badge -->
  <text x="400" y="925" fill="#e3e2e2" font-family="monospace" font-size="16" letter-spacing="4" text-anchor="middle">EXH. 01 — THE SOVEREIGN THRONE</text>
</svg>
